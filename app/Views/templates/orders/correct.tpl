<!doctype html><html lang="pl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Korekta {$parent.number|escape} · ALTREO</title><link rel="stylesheet" href="dist/css/orders.css?v=20260916-6"><style>{literal}
body{margin:0;background:#edf1f6;color:#263548;font:13px Arial,sans-serif}.correction-page{max-width:1050px;margin:0 auto;padding:28px 18px 60px}.correction-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:18px}.correction-head h1{font-size:25px;margin:5px 0}.correction-head p{color:#66788f}.correction-panel{background:#fff;border:1px solid #dfe5ee;border-radius:14px;padding:24px;margin-bottom:16px}.correction-panel h2{font-size:17px;margin:0 0 16px}.correction-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.correction-grid label,.correction-item label{display:flex;flex-direction:column;gap:6px;font-size:11px;font-weight:700;color:#465a72}.correction-grid input,.correction-grid textarea,.correction-grid select,.correction-item input,.correction-item select{width:100%;box-sizing:border-box;border:1px solid #cbd5e1;border-radius:7px;padding:9px;font:13px Arial,sans-serif;background:#fff;color:#263548}.correction-grid input[type=checkbox]{width:auto;align-self:flex-start}.correction-grid textarea{min-height:82px}.correction-wide{grid-column:1/-1}.correction-item{display:grid;grid-template-columns:minmax(210px,3fr) 80px 105px 90px 38px;gap:8px;align-items:end;margin-bottom:8px}.correction-item button{height:36px}.correction-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px}.correction-note{padding:12px 15px;background:#fff8e8;border:1px solid #f4dfa7;border-radius:8px;color:#6f571f;margin-bottom:18px}@media(max-width:760px){.correction-grid{grid-template-columns:1fr}.correction-wide{grid-column:1}.correction-item{grid-template-columns:1fr 1fr}.correction-item label:first-child{grid-column:1/-1}.correction-head,.correction-actions{flex-wrap:wrap}}
{/literal}</style></head><body><main class="correction-page"><div class="correction-head"><div><a href="?controller=orders&id={$parent.order_id}">← Zamówienie #{$parent.order_id}</a><h1>{if $correctionKind eq 'invoice_correction'}Korekta faktury{else}Korekta paragonu{/if}</h1><p>Dokument źródłowy: <a href="?controller=orders&action=printdocument&id={$parent.id}" target="_blank" rel="noopener">{$parent.number|escape}</a></p></div><a class="om-btn" href="?controller=orders&tab=documents">Lista dokumentów</a></div>
{if !empty($flashError)}<div class="om-alert error">{$flashError|escape}</div>{/if}<div class="correction-note">Oryginał pozostanie bez zmian. Po zapisaniu powstanie nowy dokument korekty, a wydruk pokaże stan przed zmianą i po zmianie.{if $parent.source_revision_id ne $parent.id} Pola wypełniono na podstawie najnowszego dokumentu: {$parent.source_revision_number|escape}.{/if}</div>
<form method="post" action="?controller=orders&action=save" id="correction-form"><input type="hidden" name="csrf" value="{$csrf|escape}"><input type="hidden" name="operation" value="document_correction"><input type="hidden" name="order_id" value="{$parent.order_id}"><input type="hidden" name="parent_id" value="{$parent.id}"><input type="hidden" name="source_revision_id" value="{$parent.source_revision_id}"><input type="hidden" name="request_key" value="{$requestKey|escape}">
<section class="correction-panel"><h2>Dokument i daty</h2><div class="correction-grid"><label>Seria korekty<select name="series_id" required>{if !$series}<option value="0">Utwórz domyślną serię korekt</option>{/if}{foreach $series as $s}<option value="{$s.id}">{$s.name|escape}</option>{/foreach}</select></label><label>Waluta dokumentu źródłowego<input name="currency" maxlength="3" pattern="[A-Z]{3}" value="{$parent.snapshot.currency|default:'PLN'|escape}" readonly title="Zmiana waluty wymaga osobnego przeliczenia kwot" required></label><label>Data wystawienia korekty<input name="issue_date" type="date" value="{$today|escape}" required></label><label>Data sprzedaży<input name="sale_date" type="date" value="{$parent.snapshot.sale_date|default:$today|escape}" required></label><label>Termin płatności<input name="payment_due_date" type="date" value="{$parent.snapshot.payment_due_date|default:''|escape}"></label><label>Numer zamówienia<input name="order_number" maxlength="190" value="{$parent.snapshot.order_number|default:''|escape}"></label><label>Metoda płatności<input name="payment_method" maxlength="150" value="{$parent.snapshot.payment_method|default:''|escape}"></label><label>Kwota już zapłacona<input name="amount_paid" inputmode="decimal" value="{(($parent.snapshot.amount_paid_cents|default:0)/100)|string_format:'%.2f'}"></label><label><input name="split_payment" type="checkbox" value="1" {if !empty($parent.snapshot.split_payment)}checked{/if}> Mechanizm podzielonej płatności</label><label class="correction-wide">Powód korekty<input name="reason" maxlength="500" placeholder="Np. zmiana ilości, ceny lub danych nabywcy" required></label></div></section>
<section class="correction-panel"><h2>Strony dokumentu</h2><div class="correction-grid"><label>Nabywca<textarea name="buyer" required>{$parent.snapshot.buyer|default:''|escape}</textarea></label><label>Nazwa sprzedawcy<input name="seller_name" value="{$parent.snapshot.seller.name|default:''|escape}" required></label><label>Adres sprzedawcy<textarea name="seller_address" required>{$parent.snapshot.seller.address|default:''|escape}</textarea></label><label>NIP sprzedawcy<input name="seller_nip" value="{$parent.snapshot.seller.nip|default:''|escape}" required></label><label>Rachunek bankowy<input name="seller_bank" value="{$parent.snapshot.seller.bank|default:''|escape}"></label><label class="correction-wide">Uwagi na dokumencie<textarea name="series_notes">{$parent.snapshot.series_notes|default:''|escape}</textarea></label></div></section>
<section class="correction-panel"><h2>Pozycje po korekcie</h2><p class="om-muted">Wpisz docelowe ilości i ceny brutto. Dla usuwanej pozycji ustaw ilość 0.</p><div data-correction-items>{foreach $parent.snapshot.items as $i=>$it}<div class="correction-item"><label>Nazwa<input name="items[{$i}][name]" value="{$it.name|escape}" maxlength="300" required></label><label>Ilość<input name="items[{$i}][quantity]" type="number" min="0" step="1" value="{$it.quantity}" required></label><label>Cena brutto<input name="items[{$i}][price]" inputmode="decimal" value="{($it.unit_cents/100)|string_format:'%.2f'}" required></label><label>VAT<select name="items[{$i}][vat]">{foreach ['23','8','5','0','zw','np'] as $v}<option value="{$v}" {if $it.vat eq $v}selected{/if}>{$v}{if $v ne 'zw' and $v ne 'np'}%{/if}</option>{/foreach}</select></label><button type="button" class="om-btn om-small" data-remove-item aria-label="Usuń pozycję">×</button></div>{/foreach}</div><button type="button" class="om-btn om-small" data-add-item>+ Dodaj pozycję</button></section>
<div class="correction-actions"><span class="om-muted">Sprawdź zmiany przed wystawieniem — korekta dostanie nowy numer.</span><button class="om-btn om-primary" type="submit">Wystaw korektę</button></div></form></main><script>{literal}
const container=document.querySelector('[data-correction-items]');
function reindex(){container.querySelectorAll('.correction-item').forEach((row,index)=>row.querySelectorAll('[name]').forEach(field=>{field.name=field.name.replace(/items\[\d+\]/,`items[${index}]`)}))}
document.querySelector('[data-add-item]').addEventListener('click',()=>{const first=container.querySelector('.correction-item');if(!first)return;const row=first.cloneNode(true);row.querySelectorAll('input').forEach(field=>{field.value=field.name.includes('[quantity]')?'1':field.name.includes('[price]')?'0.00':''});container.append(row);reindex();row.querySelector('input').focus()});
container.addEventListener('click',event=>{if(!event.target.closest('[data-remove-item]')||container.querySelectorAll('.correction-item').length<2)return;event.target.closest('.correction-item').remove();reindex()});
{/literal}</script></body></html>
