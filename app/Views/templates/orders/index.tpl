<link rel="stylesheet" href="dist/css/orders-create.css?v=20260909-1">
<link rel="stylesheet" href="dist/css/orders-cod.css?v=20260909-4">
<main class="app-main om {if $detail}om-order-view{/if}">
{if !isset($shippingDefaults)}{assign var=shippingDefaults value=['default_carrier_account_id'=>0,'default_package'=>'auto','service'=>'auto','apaczka_service_id'=>0,'pickup_type'=>'SELF','presets'=>['small'=>['length'=>23,'width'=>16,'height'=>10,'weight'=>0.5],'medium'=>['length'=>30,'width'=>20,'height'=>15,'weight'=>1],'large'=>['length'=>40,'width'=>30,'height'=>20,'weight'=>2]],'sender'=>['name'=>'','email'=>'','phone'=>'','street'=>'','building'=>'','postal_code'=>'','city'=>'']]}{/if}
{if !isset($shipmentSuggestion)}{assign var=shipmentSuggestion value=['carrier_account_id'=>0,'reason'=>'Wybierz aktywne konto nadawcze','preset'=>'medium','package'=>$shippingDefaults.presets.medium,'service'=>'inpost_locker_standard']}{/if}
{if !isset($documentDefaults)}{assign var=documentDefaults value=['vat'=>'23']}{/if}

<div class="om-shell">
  <header class="om-hero">
    <div><div class="om-eyebrow">SPRZEDAŻ · REALIZACJA</div><h1>Centrum zamówień</h1><p>Jedna kolejka dla wszystkich kanałów sprzedaży.</p></div>
    <div class="om-hero-actions"><span class="om-safe"><i class="bi bi-shield-check"></i> Marketplace: tylko odczyt</span>{if $canWrite}<a class="om-btn om-primary" href="?controller=orders&tab=new"><i class="bi bi-plus-lg"></i> Nowe zamówienie</a><button class="om-btn" type="button" data-sync="test" title="Ponownie odczytaj zamówienia z 7 dni i uzupełnij brakujące miniatury"><i class="bi bi-images"></i> Uzupełnij zdjęcia</button><button class="om-btn" type="button" data-sync="live"><i class="bi bi-arrow-repeat"></i> Synchronizuj</button>{/if}</div>
  </header>
  {if $flashSuccess}<div class="om-alert success">{$flashSuccess|escape}</div>{/if}
  {if $flashError}<div class="om-alert error">{$flashError|escape}</div>{/if}
  <div id="om-sync-result" class="om-alert" hidden role="status" aria-live="polite"></div>
  {if $tab eq 'new'}
    <section class="om-panel om-new-order">
      <div class="om-panel-heading"><div><h2>Nowe zamówienie własne</h2><p>Wprowadź klienta, produkty, walutę i sposób płatności.</p></div><a class="om-btn" href="?controller=orders"><i class="bi bi-x-lg"></i> Anuluj</a></div>
      <form method="post" action="?controller=orders&action=save" data-new-order-form>
        <input type="hidden" name="csrf" value="{$csrf|escape}"><input type="hidden" name="operation" value="create_order"><input type="hidden" name="tab" value="new">
        <div class="om-new-grid">
          <fieldset><legend>Klient i status</legend><label>Nazwa klienta<input name="buyer_name" required maxlength="255" autofocus></label><label>E-mail<input type="email" name="email"></label><label>Telefon<input name="phone"></label><label>Data zamówienia<input type="datetime-local" name="ordered_at" value="{$smarty.now|date_format:'%Y-%m-%dT%H:%M'}" required></label><label>Status<select name="status_id" required>{foreach $statuses as $s}<option value="{$s.id}">{$s.name|escape}</option>{/foreach}</select></label></fieldset>
          <fieldset><legend>Dostawa</legend><label>Metoda dostawy<input name="delivery" placeholder="Np. kurier, odbiór osobisty"></label><label>Koszt dostawy<input inputmode="decimal" name="shipping_price" value="0.00" data-new-shipping></label><label>Ulica<input name="shipping_street"></label><label>Nr budynku / lokalu<input name="shipping_building"></label><label>Kod pocztowy<input name="shipping_postal_code"></label><label>Miasto<input name="shipping_city"></label><label>Kraj<select name="shipping_country"><option value="PL">Polska (PL)</option><option value="CZ">Czechy (CZ)</option><option value="HU">Węgry (HU)</option><option value="DE">Niemcy (DE)</option><option value="SK">Słowacja (SK)</option><option value="AT">Austria (AT)</option><option value="RO">Rumunia (RO)</option><option value="GB">Wielka Brytania (GB)</option><option value="US">USA (US)</option></select></label></fieldset>
          <fieldset><legend>Płatność</legend><label>Metoda płatności<select name="payment_method" data-new-payment>{foreach $paymentMethods as $method}{if $method.enabled}<option value="{$method.name|escape}" data-cod="{$method.is_cod}">{$method.name|escape}</option>{/if}{/foreach}</select></label><label>Waluta<select name="currency" data-new-currency required>{foreach ['PLN'=>'PLN — złoty','EUR'=>'EUR — euro','USD'=>'USD — dolar amerykański','GBP'=>'GBP — funt','CZK'=>'CZK — korona czeska','HUF'=>'HUF — forint','CHF'=>'CHF — frank','SEK'=>'SEK — korona szwedzka','NOK'=>'NOK — korona norweska','DKK'=>'DKK — korona duńska','RON'=>'RON — lej','BGN'=>'BGN — lew','UAH'=>'UAH — hrywna'] as $code=>$label}<option value="{$code}">{$label}</option>{/foreach}</select></label><label>Zapłacono<input inputmode="decimal" name="amount_paid" value="0.00"></label><label class="om-check"><input type="checkbox" name="paid" value="1" data-new-paid> Płatność potwierdzona</label><label class="om-check"><input type="checkbox" name="cash_on_delivery" value="1" data-new-cod> Płatność przy odbiorze</label><label>Dokument<select name="document_preference"><option value="receipt">Paragon</option><option value="invoice">Faktura</option></select></label></fieldset>
        </div>
        <fieldset class="om-new-items"><legend>Produkty</legend><div class="om-new-items-head"><span>Dodaj wszystkie pozycje zamówienia. Suma wyliczy się automatycznie.</span><button class="om-btn" type="button" data-add-new-item><i class="bi bi-plus-lg"></i> Dodaj produkt</button></div><div data-new-items><div class="om-new-item"><label>Nazwa produktu<input name="items[0][name]" required></label><label>SKU<input name="items[0][sku]"></label><label>Ilość<input type="number" min="1" max="100000" name="items[0][quantity]" value="1" required data-new-qty></label><label>Cena brutto<input inputmode="decimal" name="items[0][price]" value="0.00" required data-new-price></label><label>VAT<select name="items[0][vat]">{foreach ['23','8','5','0','zw','np'] as $v}<option value="{$v}">{$v}{if $v ne 'zw' and $v ne 'np'}%{/if}</option>{/foreach}</select></label><strong data-new-line-total>0,00 PLN</strong><button class="om-icon-btn" type="button" data-remove-new-item aria-label="Usuń pozycję"><i class="bi bi-trash"></i></button></div></div></fieldset>
        <div class="om-new-footer"><label>Uwagi do zamówienia<textarea name="buyer_note" rows="2"></textarea></label><div><span>Razem</span><strong data-new-total>0,00 PLN</strong><input type="hidden" name="total" value="0.00" data-new-total-input><button class="om-btn om-primary"><i class="bi bi-check2"></i> Utwórz zamówienie</button></div></div>
      </form>
    </section>
  {elseif $tab eq 'list'}
    <div class="om-workspace {if $detail}has-detail{/if}">
      <aside class="om-status-list"><div class="om-label">KOLEJKI ZAMÓWIEŃ</div><a href="?controller=orders" class="{if $filters.status_id eq ''}active{/if}"><span><i class="om-all-dot"></i>Wszystkie</span><b>{$dashboard.total}</b></a>{foreach $dashboard.statuses as $s}<a class="{if $filters.status_id eq $s.id}active{/if}" href="?controller=orders&status_id={$s.id}"><span><i style="background:{$s.color|escape}"></i>{$s.name|escape}</span><b>{$s.total}</b></a>{/foreach}<div class="om-queue-summary"><span><b>{$dashboard.today}</b> dzisiaj</span><span><b>{$dashboard.unpaid}</b> do weryfikacji</span></div><div class="om-sidebar-note"><i class="bi bi-shield-check"></i><p>Statusy są lokalne i nie zmieniają zamówienia w marketplace.</p></div></aside>
      {if !$detail}<section class="om-panel om-order-list">
        <div class="om-list-heading"><div><h2>{if $filters.status_id eq ''}Wszystkie zamówienia{else}{foreach $dashboard.statuses as $s}{if $filters.status_id eq $s.id}{$s.name|escape}{/if}{/foreach}{/if}</h2><p><strong>{$listing.total}</strong> wyników <span>·</span> aktualizowane z połączonych kont</p></div><div class="om-list-heading-actions"><span class="om-result-range">Strona {$listing.page} z {$listing.pages}</span><button class="om-icon-btn" type="button" data-density-toggle title="Zmień gęstość wierszy" aria-label="Zmień gęstość wierszy"><i class="bi bi-text-paragraph"></i></button><button class="om-btn" type="button" data-columns-open><i class="bi bi-layout-three-columns"></i> Kolumny</button></div></div>
        <form class="om-filter-form" method="get"><input type="hidden" name="controller" value="orders"><input type="hidden" name="status_id" value="{$filters.status_id|escape}">
          <div class="om-listbar"><div class="om-search"><i class="bi bi-search"></i><input name="q" value="{$filters.q|escape}" placeholder="Szukaj po numerze, kliencie, e-mailu, telefonie, tagu…" aria-label="Szukaj zamówień"></div><select name="account_id" aria-label="Konto"><option value="">Wszystkie konta</option>{foreach $accounts as $a}<option value="{$a.id}" {if $filters.account_id eq $a.id}selected{/if}>{$a.platform|escape} · {$a.name|escape}</option>{/foreach}</select><button class="om-btn {if $activeFilterCount}is-filtered{/if}" type="button" data-filters-toggle aria-expanded="{if $activeFilterCount}true{else}false{/if}"><i class="bi bi-funnel"></i> Filtry{if $activeFilterCount}<b>{$activeFilterCount}</b>{/if}</button><button class="om-btn om-primary" type="submit"><i class="bi bi-search"></i> Pokaż</button></div>
          <div class="om-filter-drawer {if $activeFilterCount}is-open{/if}" data-filter-drawer>
            <label>Platforma<select name="platform"><option value="">Wszystkie</option>{foreach ['manual'=>'Własne','allegro'=>'Allegro','erli'=>'ERLI','empik'=>'Empik','mediamarkt'=>'MediaMarkt','morele'=>'Morele'] as $value=>$label}<option value="{$value}" {if $filters.platform eq $value}selected{/if}>{$label}</option>{/foreach}</select></label>
            <label>Płatność<select name="paid"><option value="">Dowolna</option><option value="1" {if $filters.paid eq '1'}selected{/if}>Potwierdzona</option><option value="0" {if $filters.paid eq '0'}selected{/if}>Niepotwierdzona</option></select></label>
            <label>Data od<input type="date" name="date_from" value="{$filters.date_from|escape}"></label><label>Data do<input type="date" name="date_to" value="{$filters.date_to|escape}"></label>
            <label>Kwota od<input inputmode="decimal" name="amount_from" value="{$filters.amount_from|escape}" placeholder="0,00"></label><label>Kwota do<input inputmode="decimal" name="amount_to" value="{$filters.amount_to|escape}" placeholder="9999,00"></label>
            <label>Sortowanie<select name="sort"><option value="newest" {if $filters.sort eq 'newest'}selected{/if}>Najnowsze najpierw</option><option value="oldest" {if $filters.sort eq 'oldest'}selected{/if}>Najstarsze najpierw</option><option value="amount_desc" {if $filters.sort eq 'amount_desc'}selected{/if}>Kwota: malejąco</option><option value="amount_asc" {if $filters.sort eq 'amount_asc'}selected{/if}>Kwota: rosnąco</option><option value="buyer" {if $filters.sort eq 'buyer'}selected{/if}>Klient A–Z</option></select></label>
            <div class="om-filter-actions"><a href="?controller=orders{if $filters.status_id ne ''}&status_id={$filters.status_id|escape:'url'}{/if}">Wyczyść filtry</a><button class="om-btn om-primary" type="submit">Zastosuj filtry</button></div>
          </div>
        </form>
        <form method="post" action="?controller=orders&action=save"><input type="hidden" name="csrf" value="{$csrf|escape}">
          {if $canWrite}<div class="om-bulk"><label class="om-select-page"><input type="checkbox" id="om-select-all"> Zaznacz stronę</label><span data-selected-count>0 zaznaczonych</span><span class="om-bulk-separator"></span><select name="status_id" aria-label="Status zaznaczonych">{foreach $statuses as $s}<option value="{$s.id}">{$s.name|escape}</option>{/foreach}</select><button class="om-btn om-small" type="submit" name="operation" value="bulk"><i class="bi bi-arrow-left-right"></i> Zmień status</button><button class="om-btn om-small om-danger-outline" type="submit" name="operation" value="bulk_delete" data-confirm-click="Usunąć zaznaczone zamówienia? Tej operacji nie można cofnąć. Zamówienia z marketplace mogą pojawić się ponownie przy kolejnej synchronizacji, chyba że wcześniej wstrzymasz import konta w zakładce Konta."><i class="bi bi-trash"></i> Usuń zaznaczone</button></div>{/if}
          <div class="om-table-wrap"><table class="om-table om-orders-table" data-configurable-table><thead><tr>{if $canWrite}<th class="om-select-cell"></th>{/if}<th data-col="order">Numer zamówienia</th><th data-col="buyer">Klient</th><th data-col="products">Przedmioty</th><th data-col="amount" class="om-right">Kwota</th><th data-col="status">Status</th><th data-col="payment">Płatność</th><th data-col="delivery">Dostawa</th><th data-col="source">Źródło</th><th data-col="tags">Tagi / notatka</th><th data-col="date">Data złożenia</th></tr></thead><tbody>
          {foreach $listing.rows as $o}<tr>{if $canWrite}<td class="om-select-cell"><input type="checkbox" name="ids[]" value="{$o.id}" aria-label="Zaznacz {$o.external_id|escape}"></td>{/if}
            <td data-col="order"><div class="om-order-cell"><button class="om-star" type="button" aria-label="Oznacz gwiazdką"><i class="bi bi-star"></i></button><div><a class="om-order-number" href="?controller=orders&id={$o.id}">{$o.id}</a><button class="om-external-number" type="button" data-copy-order="{$o.external_id|escape}" title="Kliknij, aby skopiować pełny numer: {$o.external_id|escape}"><i class="bi bi-copy"></i><span>{$o.external_short|escape}</span></button><small><span class="om-market {$o.platform|escape}">{$o.platform|escape}</span> {$o.account_name|escape}</small></div></div></td>
            <td data-col="buyer"><strong class="om-ellipsis">{$o.buyer_name|escape}</strong><a class="om-cell-link om-ellipsis" href="mailto:{$o.email|escape}">{$o.email|escape}</a>{if $o.phone}<small class="om-ellipsis">{$o.phone|escape}</small>{/if}</td>
            <td data-col="products"><div class="om-products">{foreach $o.items as $item}<div class="om-product-line"><span class="om-product-thumb">{if $item.image_url}<img src="{$item.image_url|escape}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-product-image>{else}<i class="bi bi-box"></i>{/if}</span><span><strong>{$item.quantity}× {$item.name|escape}</strong>{if $item.sku}<small>SKU: {$item.sku|escape}</small>{/if}</span></div>{/foreach}{if $o.item_lines gt 3}<button type="button" class="om-more-products">+ {$o.item_lines-3} więcej</button>{/if}{if $o.item_lines eq 0}<span class="om-muted">Brak pozycji</span>{/if}</div></td>
            <td data-col="amount" class="om-right"><strong class="om-amount">{($o.total_cents/100)|string_format:'%.2f'} {$o.currency|escape}</strong><small>dostawa {($o.shipping_cents/100)|string_format:'%.2f'}</small></td>
            <td data-col="status"><span class="om-status" style="--status:{$o.color|escape}">{$o.status_name|escape}</span><small class="om-ellipsis">{$o.remote_status|escape}</small></td>
            <td data-col="payment">{if $o.cash_on_delivery|default:0}<span class="om-payment is-cod"><i class="bi bi-cash-coin"></i> Pobranie</span>{else}<span class="om-payment {if $o.paid}is-paid{/if}"><i class="bi {if $o.paid}bi-check-circle-fill{else}bi-clock{/if}"></i>{if $o.paid} Opłacone{else} Do weryfikacji{/if}</span>{/if}</td>
            <td data-col="delivery"><strong class="om-ellipsis">{$o.delivery|default:'Brak danych'|escape}</strong>{if $o.pickup}<small class="om-cell-link om-ellipsis">{$o.pickup|escape}</small>{/if}</td>
            <td data-col="source"><span class="om-market {$o.platform|escape}">{$o.platform|escape}</span><small class="om-ellipsis">{$o.account_name|escape}</small></td>
            <td data-col="tags">{if $o.tags}<span class="om-tag">{$o.tags|escape}</span>{/if}{if $o.note}<small class="om-ellipsis">{$o.note|escape}</small>{/if}{if !$o.tags && !$o.note}<span class="om-muted">—</span>{/if}</td>
            <td data-col="date"><strong>{$o.ordered_at|escape}</strong><small>UTC</small></td>
          </tr>{foreachelse}<tr class="om-empty-row"><td colspan="11"><div class="om-empty"><i class="bi bi-inbox"></i><h3>Nie znaleziono zamówień</h3><p>{if $filters.q or $activeFilterCount}Zmień lub wyczyść filtry, aby zobaczyć więcej wyników.{else}Połącz konta i pobierz zamówienia z ostatnich 7 dni.{/if}</p><a class="om-btn om-primary" href="?controller=orders&tab=accounts">Konta i import →</a></div></td></tr>{/foreach}</tbody></table></div>
        </form>
        <div class="om-pagination"><span>{$listing.total} pozycji · 50 na stronę</span><div>{if $listing.page gt 1}<a class="om-icon-btn" aria-label="Poprzednia strona" href="?controller=orders&page={$listing.page-1}{if $listQuery}&{$listQuery|escape}{/if}"><i class="bi bi-chevron-left"></i></a>{/if}<b>{$listing.page}</b>{if $listing.page lt $listing.pages}<a class="om-icon-btn" aria-label="Następna strona" href="?controller=orders&page={$listing.page+1}{if $listQuery}&{$listQuery|escape}{/if}"><i class="bi bi-chevron-right"></i></a>{/if}</div></div>
        <div class="om-columns-backdrop" data-columns-backdrop hidden></div><aside class="om-columns-panel" data-columns-panel aria-hidden="true"><div class="om-columns-head"><div><small>WIDOK LISTY</small><h3>Kolumny i szerokości</h3></div><button class="om-icon-btn" type="button" data-columns-close aria-label="Zamknij"><i class="bi bi-x-lg"></i></button></div><p>Przeciągnij pola, aby zmienić kolejność. Ustawienia zapisują się w tej przeglądarce.</p><div class="om-column-list" data-column-list>
          {foreach ['order'=>'Numer zamówienia','buyer'=>'Klient','products'=>'Przedmioty','amount'=>'Kwota','status'=>'Status','payment'=>'Płatność','delivery'=>'Dostawa','source'=>'Źródło','tags'=>'Tagi / notatka','date'=>'Data złożenia'] as $key=>$label}<div class="om-column-option" draggable="true" data-column-option="{$key}"><i class="bi bi-grip-vertical"></i><label><input type="checkbox" data-column-toggle="{$key}" {if in_array($key,['order','buyer','products','amount','status','date'])}checked{/if}><span>{$label}</span></label><input type="range" min="90" max="420" step="10" value="{if $key eq 'products'}300{elseif $key eq 'buyer'}190{elseif $key eq 'order'}170{elseif $key eq 'date'}150{else}130{/if}" data-column-width="{$key}" aria-label="Szerokość: {$label}"><output></output></div>{/foreach}
        </div><div class="om-columns-footer"><button class="om-btn" type="button" data-columns-reset>Przywróć domyślny</button><button class="om-btn om-primary" type="button" data-columns-close>Gotowe</button></div></aside>
      </section>
      {/if}{if $detail}{include file='orders/detail.tpl'}{/if}
    </div>
  {elseif $tab eq 'accounts'}
    <div class="om-section-heading"><div><h2>Twoje kanały sprzedaży</h2><p>Każde konto ma własny import, kursor i mapowanie statusów.</p></div>{if $canWrite}<form method="post" action="?controller=orders&action=save"><input type="hidden" name="csrf" value="{$csrf|escape}"><input type="hidden" name="operation" value="discover"><input type="hidden" name="tab" value="accounts"><button class="om-btn om-primary">Wczytaj konta z integracji</button></form>{/if}</div>
    <div class="om-alert">Import testowy i bieżący obejmuje wyłącznie zamówienia utworzone w ostatnich 7 dniach. Import testowy zapisuje prawdziwe zamówienia lokalnie. Powtórzenie odświeża dane, bez duplikatów.</div>
    <div class="om-account-grid">{foreach $accounts as $a}<article class="om-panel"><div class="om-panel-heading"><span class="om-market {$a.platform|escape}">{$a.platform|escape}</span><span class="om-chip">{if $a.enabled}Import włączony{else}Import wstrzymany{/if}</span>{if $a.platform eq 'empik' || $a.platform eq 'mediamarkt'}<span class="om-chip{if $a.auto_accept} om-chip-on{/if}">{if $a.auto_accept}Auto-akceptacja: włączona{else}Auto-akceptacja: wyłączona{/if}</span>{/if}</div><div class="om-pad"><h3>{$a.name|escape}</h3><p class="om-muted">Konto źródłowe #{$a.source_id}</p><dl><dt>Ostatni odczyt (UTC)</dt><dd>{$a.last_sync|default:'Jeszcze nie pobierano'|escape}</dd><dt>Kolejka</dt><dd>{if $a.cursor_json}Pozostały kolejne strony{else}Brak oczekujących stron{/if}</dd></dl>{if $a.last_error}<div class="om-alert error">{$a.last_error|escape}</div>{/if}{if $a.platform eq 'morele'}<div class="om-alert">Adapter zamówień Morele oczekuje na specyfikację API. Obecna integracja ofert obsługuje jedno konto.</div>{elseif $canWrite}<div class="om-actions"><form method="post" action="?controller=orders&action=save"><input type="hidden" name="csrf" value="{$csrf|escape}"><input type="hidden" name="operation" value="account"><input type="hidden" name="tab" value="accounts"><input type="hidden" name="account_id" value="{$a.id}"><input type="hidden" name="enabled" value="{if $a.enabled}0{else}1{/if}"><button class="om-btn">{if $a.enabled}Wstrzymaj import{else}Włącz import bieżący{/if}</button></form>{if $a.platform eq 'empik' || $a.platform eq 'mediamarkt'}<form method="post" action="?controller=orders&action=save" title="Automatycznie akceptuje w Mirakl (OR21) każde zamówienie oczekujące na akceptację, gdy tylko trafi do importu."><input type="hidden" name="csrf" value="{$csrf|escape}"><input type="hidden" name="operation" value="account_auto_accept"><input type="hidden" name="tab" value="accounts"><input type="hidden" name="account_id" value="{$a.id}"><input type="hidden" name="auto_accept" value="{if $a.auto_accept}0{else}1{/if}"><button class="om-btn{if !$a.auto_accept} om-primary{/if}">{if $a.auto_accept}Wyłącz auto-akceptację{else}Włącz auto-akceptację{/if}</button></form>{/if}<button type="button" class="om-btn om-primary" data-sync="test" data-account="{$a.id}">Test: ostatnie 7 dni</button></div>{/if}</div></article>{foreachelse}<div class="om-panel om-empty"><i class="bi bi-plug"></i><h3>Podłącz istniejące integracje</h3><p>Kliknij „Wczytaj konta z integracji”. Klucze API pozostają w ustawieniach platform.</p></div>{/foreach}</div>
    <div class="om-panel om-pad om-top"><h3>Praca w tle</h3><p>Uruchom na serwerze co minutę: <code>php bin/orders-sync.php</code>. Polecenie pobiera jedną stronę na konto w każdym przebiegu; kursor jest zachowywany. W otwartej zakładce dodatkowo działa odczyt co 60 sekund.</p><p class="om-muted">Nowe konta dodawaj w istniejących ustawieniach Allegro, Erli, Empik lub MediaMarkt, następnie wczytaj je tutaj. Tryb odczytu nie zmienia statusów i nie dodaje numerów paczek na platformach. Jedyny wyjątek to opcjonalna auto-akceptacja zamówień Empik/MediaMarkt włączana osobno dla każdego konta poniżej.</p></div>
