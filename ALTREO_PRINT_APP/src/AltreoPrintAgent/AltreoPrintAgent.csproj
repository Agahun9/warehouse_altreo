<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>AltreoPrintAgent</AssemblyName>
    <RootNamespace>AltreoPrintAgent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets/app.ico')">Assets/app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.1.0</Version>
    <Description>Tray agent for automatic PDF printing from magazyn.altreo.pl</Description>
    <AgentProfile Condition="'$(AgentProfile)' == ''">production</AgentProfile>
    <DefineConstants Condition="'$(AgentProfile)' == 'sandbox'">$(DefineConstants);SANDBOX</DefineConstants>
    <AssemblyName Condition="'$(AgentProfile)' == 'sandbox'">AltreoPrintAgent-Sandbox</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.21" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.21" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Assets/SumatraPDF.exe') and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">
    <EmbeddedResource Include="Assets/SumatraPDF.exe" LogicalName="AltreoPrintAgent.SumatraPDF.exe" />
  </ItemGroup>
</Project>
