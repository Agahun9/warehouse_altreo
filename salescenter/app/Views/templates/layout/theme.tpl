{* Tryb ciemny: wybór zapisany w localStorage ('sc-theme'). Skrypt działa przed renderowaniem strony, więc nie ma mignięcia jasnego motywu. *}
{literal}<script>(function(){var root=document.documentElement;function apply(t){root.setAttribute('data-bs-theme',t==='dark'?'dark':'light');}var saved=null;try{saved=localStorage.getItem('sc-theme');}catch(e){}apply(saved);document.addEventListener('click',function(e){var btn=e.target&&e.target.closest?e.target.closest('[data-sc-theme-toggle]'):null;if(!btn){return;}var next=root.getAttribute('data-bs-theme')==='dark'?'light':'dark';apply(next);try{localStorage.setItem('sc-theme',next);}catch(err){}});window.addEventListener('storage',function(e){if(e.key==='sc-theme'){apply(e.newValue);}});})();</script>{/literal}
