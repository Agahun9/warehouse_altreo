<div class="om-pagination"><form method="get"><input type="hidden" name="controller" value="orders">{foreach $filters as $key=>$value}{if $key ne 'page' and $key ne 'per_page' and $value neq ''}<input type="hidden" name="{$key|escape}" value="{$value|escape}">{/if}{/foreach}<label>{$listing.total} pozycji · <select name="per_page" aria-label="Liczba zamówień na stronie">{foreach [50,100,150,200,500,1000,2000] as $size}<option value="{$size}" {if $listing.per_page eq $size}selected{/if}>{$size}</option>{/foreach}</select> na stronę</label> <button class="om-btn om-small" type="submit">Pokaż</button></form><div>{if $listing.page gt 1}<a class="om-icon-btn" aria-label="Poprzednia strona" href="?controller=orders&page={$listing.page-1}{if $listQuery}&{$listQuery|escape}{/if}"><i class="bi bi-chevron-left"></i></a>{/if}<b style="width:auto;min-width:29px;padding:0 8px">{$listing.page} / {$listing.pages}</b>{if $listing.page lt $listing.pages}<a class="om-icon-btn" aria-label="Następna strona" href="?controller=orders&page={$listing.page+1}{if $listQuery}&{$listQuery|escape}{/if}"><i class="bi bi-chevron-right"></i></a>{/if}</div></div>
