<!doctype html><html lang="pl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{$document.number|escape}</title><style>{literal}
@import url('https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap');
*{box-sizing:border-box}body{margin:0;background:#e8ecf1;color:#1a1a1a;font:10px 'Source Sans 3',Arial,sans-serif}.toolbar{max-width:210mm;margin:18px auto;display:flex;justify-content:space-between;gap:12px;align-items:center}.toolbar a,.toolbar button{padding:10px 15px;border:0;border-radius:6px;background:#253b69;color:#fff;text-decoration:none;font:600 12px Arial;cursor:pointer}.sheet{width:210mm;min-height:297mm;margin:0 auto 24px;background:#fff;padding:15mm 16mm 18mm;box-shadow:0 7px 30px #1b2d441e}.doc-header{margin-bottom:23px}.logo-row{text-align:center;min-height:48px}.logo-row img{max-width:135px;max-height:52px;object-fit:contain}.title-row{display:flex;justify-content:space-between;align-items:flex-end;gap:24px}.doc-title{font-size:19px;font-weight:700;text-align:right}.doc-subtitle{font-size:10px;text-align:right}.doc-id{font-size:9px;color:#58616e}.parties{display:grid;grid-template-columns:1.45fr 1fr;gap:22px;margin-bottom:20px}.parties.top{padding-bottom:14px;border-bottom:1px solid #1a1a1a}.party{white-space:pre-line;overflow-wrap:anywhere;line-height:1.45}.party strong,.meta strong{font-weight:700}.meta{line-height:1.55}.buyer{font-size:12px}.recipient{font-size:11px}.section-label{font-size:10px;font-weight:700;margin:16px 0 5px}.items{width:100%;border-collapse:collapse;table-layout:fixed;margin-top:15px;font-size:9px}.items th{background:#e9e9e9;font-weight:700}.items th,.items td{border:1px solid #b4b4b4;padding:5px 4px;text-align:right;vertical-align:top;overflow-wrap:anywhere}.items th:first-child,.items td:first-child,.items th:nth-child(2),.items td:nth-child(2){text-align:left}.items th:first-child{width:25px}.items th:nth-child(2){width:31%}.items .unit{width:32px}.items .qty{width:44px}.items .vat{width:38px}.items .currency{width:38px}.amounts{display:flex;justify-content:flex-end;margin:15px 0 21px}.amounts table{border-collapse:collapse;min-width:330px;font-size:9px}.amounts th,.amounts td{border:1px solid #b4b4b4;padding:5px 7px;text-align:right}.amounts th{background:#e9e9e9}.amounts td:first-child,.amounts th:first-child{text-align:left}.amounts .total td{font-weight:700;background:#f4f4f4}.payment{display:flex;gap:18px;align-items:flex-start;margin:18px 0 24px}.payable{min-width:235px;font-size:12px;font-weight:700}.payment-note{flex:1;line-height:1.4}.comments{padding:10px 12px;border:1px solid #bbb;border-radius:4px;white-space:pre-line;overflow-wrap:anywhere;margin:13px 0}.signatures{display:grid;grid-template-columns:1fr 1fr;gap:50px;margin:65px 0 30px}.signatures div{border-top:1px solid #111;padding-top:6px;text-align:center;font-size:9px}.footer{border-top:1px solid #d1d1d1;padding-top:8px;font-size:9px;color:#555}.notice{font-size:9px;color:#555;margin-top:15px}.ksef-qr{display:flex;gap:14px;align-items:center;margin:18px 0 0;padding:10px 12px;border:1px solid #b4b4b4;border-radius:4px;break-inside:avoid}.ksef-qr-code{width:120px;flex:0 0 120px;text-align:center}.ksef-qr-code svg,.ksef-qr-code img{width:120px;height:120px;display:block}.ksef-qr-code small{display:block;margin-top:3px;font-size:8px;font-weight:700;overflow-wrap:anywhere}.ksef-qr-info{line-height:1.5}.ksef-qr-info a{color:#1a1a1a;overflow-wrap:anywhere;font-size:8px}.before{background:#f8f8f8;padding:10px;border:1px solid #ddd;margin-top:18px}.before .items{margin-top:7px}.before p{margin:4px 0}.break-avoid,.parties,.amounts,.payment,.signatures,.items tr{break-inside:avoid}@page{size:A4;margin:0}@media print{body{background:#fff}.toolbar{display:none}.sheet{width:210mm;min-height:297mm;margin:0;box-shadow:none;padding:15mm 16mm 18mm}thead{display:table-header-group}}@media screen and (max-width:820px){.sheet{width:100%;min-height:0;padding:20px}.toolbar{padding:0 12px}.parties{grid-template-columns:1fr}.items{font-size:8px}}
{/literal}</style></head><body>
<div class="toolbar"><a href="?controller=orders&id={$document.order_id}">← Zamówienie</a><div>{if !empty($canWrite)}<a href="?controller=orders&action=correctdocument&id={$document.id}">Wystaw korektę</a> {/if}<button onclick="window.print()">Drukuj / zapisz PDF</button></div></div>
{assign var=d value=$document.snapshot}
<article class="sheet"><header class="doc-header"><div class="title-row"><span class="doc-id">Dokument sprzedaży</span><div><div class="doc-title">{if $document.kind eq 'invoice'}Faktura{elseif $document.kind eq 'receipt'}Paragon{elseif $document.kind eq 'invoice_correction'}Faktura korygująca{elseif $document.kind eq 'receipt_correction'}Korekta paragonu{else}Dokument{/if} {$document.number|escape}</div>{if $document.kind eq 'receipt' or $document.kind eq 'receipt_correction'}<div class="doc-subtitle">Wydruk lokalny — niefiskalny</div>{/if}</div></div></header>
<section class="parties top"><div class="party"><strong>Sprzedawca:</strong> {$d.seller.name|default:''|escape}<br>{$d.seller.address|default:''|escape}<br>NIP: {$d.seller.nip|default:''|escape}{if !empty($d.seller.bank)}<br>Rachunek: {$d.seller.bank|escape}{/if}</div><div class="meta">Wystawiono: {$d.issue_date|default:''|escape}<br>Data sprzedaży: {$d.sale_date|default:''|escape}{if !empty($d.payment_due_date)}<br><strong>Termin płatności: {$d.payment_due_date|escape}</strong>{/if}{if !empty($d.payment_method)}<br>Metoda płatności: {$d.payment_method|escape}{/if}<br>Zamówienie: {$d.order_number|default:''|escape}</div></section>
<section class="parties"><div class="party buyer"><strong>Nabywca:</strong><br>{$d.buyer|default:''|escape}</div>{if !empty($d.recipient)}<div class="party recipient"><strong>Dane dostawy:</strong><br>{$d.recipient|escape}</div>{/if}</section>
{if isset($d.parent_number)}<div class="before"><strong>Korekta do: {$d.parent_number|escape}</strong><p>Powód: {$d.reason|default:''|escape}</p><p><strong>Stan przed korektą</strong> — nabywca: {$d.before.buyer|default:''|escape}{if !empty($d.before.recipient) && $d.before.recipient ne $d.recipient|default:''}<br>dane dostawy: {$d.before.recipient|escape}{/if}</p><table class="items"><thead><tr><th>Lp.</th><th>Nazwa</th><th class="qty">Ilość</th><th>Cena brutto</th><th class="vat">VAT</th><th>Wartość brutto</th></tr></thead><tbody>{foreach $d.before.items as $i=>$item}<tr><td>{$i+1}</td><td>{$item.name|escape}</td><td>{$item.quantity}</td><td>{($item.unit_cents/100)|string_format:'%.2f'}</td><td>{$item.vat|escape}</td><td>{($item.gross_cents/100)|string_format:'%.2f'}</td></tr>{/foreach}</tbody></table><p>Razem przed korektą: <strong>{($d.before.gross_cents/100)|string_format:'%.2f'} {$d.before.currency|default:$d.currency|escape}</strong></p></div><div class="section-label">Stan po korekcie</div>{/if}
<table class="items"><thead><tr><th>Lp.</th><th>Nazwa towaru / usługi</th><th class="unit">JM</th><th class="qty">Ilość</th><th class="currency">Waluta</th><th>Cena brutto</th><th>Wartość netto</th><th class="vat">VAT</th><th>Kwota VAT</th><th>Wartość brutto</th></tr></thead><tbody>{foreach $d.items as $i=>$item}<tr><td>{$i+1}</td><td>{$item.name|escape}</td><td>szt.</td><td>{$item.quantity}</td><td>{$d.currency|escape}</td><td>{($item.unit_cents/100)|string_format:'%.2f'}</td><td>{($item.net_cents/100)|string_format:'%.2f'}</td><td>{$item.vat|escape}{if $item.vat ne 'zw' and $item.vat ne 'np'}%{/if}</td><td>{($item.tax_cents/100)|string_format:'%.2f'}</td><td>{($item.gross_cents/100)|string_format:'%.2f'}</td></tr>{/foreach}</tbody></table>
<div class="amounts break-avoid"><table><thead><tr><th>Podsumowanie</th><th>Netto</th><th>VAT</th><th>Brutto</th></tr></thead><tbody><tr class="total"><td>Razem {$d.currency|escape}</td><td>{($d.net_cents/100)|string_format:'%.2f'}</td><td>{($d.tax_cents/100)|string_format:'%.2f'}</td><td>{($d.gross_cents/100)|string_format:'%.2f'}</td></tr>{foreach $document.vat_summary as $vatRow}<tr><td>W tym VAT {$vatRow.vat|escape}{if $vatRow.vat ne 'zw' and $vatRow.vat ne 'np'}%{/if}</td><td>{($vatRow.net_cents/100)|string_format:'%.2f'}</td><td>{($vatRow.tax_cents/100)|string_format:'%.2f'}</td><td>{($vatRow.gross_cents/100)|string_format:'%.2f'}</td></tr>{/foreach}</tbody></table></div>
<div class="payment break-avoid"><div class="payable">{if isset($d.difference_cents)}Różnica brutto: {($d.difference_cents/100)|string_format:'%.2f'} {$d.currency|escape}{elseif isset($d.amount_paid_cents) && $d.amount_paid_cents >= $d.gross_cents}Zapłacono: {($d.amount_paid_cents/100)|string_format:'%.2f'} {$d.currency|escape}{else}Do zapłaty: {(($d.gross_cents-($d.amount_paid_cents|default:0))/100)|string_format:'%.2f'} {$d.currency|escape}{/if}</div><div class="payment-note">{if isset($d.difference_net_cents)}Różnica netto: {($d.difference_net_cents/100)|string_format:'%.2f'} {$d.currency|escape} · VAT: {($d.difference_tax_cents/100)|string_format:'%.2f'} {$d.currency|escape}<br>{/if}{if !empty($d.split_payment)}Mechanizm podzielonej płatności.{/if}</div></div>
{if !empty($d.series_notes)}<div class="comments">{$d.series_notes|escape}</div>{/if}
{if !empty($d.additional_info)}<div class="comments"><strong>Dodatkowa informacja:</strong><br>{$d.additional_info|escape}</div>{/if}
<div class="signatures break-avoid"><div>Podpis osoby upoważnionej do wystawienia</div><div>Podpis osoby upoważnionej do odbioru</div></div>
{if !empty($document.ksef.qr_url)}<section class="ksef-qr"><div class="ksef-qr-code"><div data-ksef-qr="{$document.ksef.qr_url|escape}"></div><small>{$document.ksef.ksef_number|escape}</small></div><div class="ksef-qr-info"><strong>Faktura wystawiona w KSeF</strong><br>Numer KSeF: <strong>{$document.ksef.ksef_number|escape}</strong>{if $document.ksef.environment ne 'production'}<br>Środowisko testowe — bez skutków podatkowych.{/if}<br>Zeskanuj kod, aby zweryfikować fakturę:<br><a href="{$document.ksef.qr_url|escape}">{$document.ksef.qr_url|escape}</a></div></section><script src="dist/js/qrcode-generator.js"></script>{literal}<script>document.querySelectorAll('[data-ksef-qr]').forEach(function(el){try{var qr=qrcode(0,'M');qr.addData(el.getAttribute('data-ksef-qr'),'Byte');qr.make();el.innerHTML=qr.createSvgTag({ cellSize:4,margin:0,scalable:true });}catch(e){}});</script>{/literal}{/if}
<div class="notice">{if !empty($document.ksef) && $document.ksef.state eq 'accepted' && empty($document.ksef.qr_url)}Numer KSeF: <strong>{$document.ksef.ksef_number|escape}</strong>{if $document.ksef.environment ne 'production'} (środowisko testowe — bez skutków podatkowych){/if}.{elseif !empty($document.ksef) && $document.ksef.state eq 'processing'}Faktura przetwarzana w KSeF — numer KSeF pojawi się po odświeżeniu statusu.{/if}{if $document.kind eq 'receipt' or $document.kind eq 'receipt_correction'} Ten wydruk nie zastępuje paragonu fiskalnego z drukarki.{/if}</div></article></body></html>
