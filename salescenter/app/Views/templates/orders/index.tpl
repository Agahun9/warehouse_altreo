<link rel="stylesheet" href="dist/css/orders-create.css?v=20260909-1">
<link rel="stylesheet" href="dist/css/orders-cod.css?v=20260909-4">
<link rel="stylesheet" href="dist/css/orders-automation.css?v=20260922-2">
<link rel="stylesheet" href="dist/css/orders-ksef.css?v=20260917-2">
<main class="app-main om {if $detail}om-order-view{/if}">
{if !isset($shippingDefaults)}{assign var=shippingDefaults value=['default_carrier_account_id'=>0,'default_package'=>'auto','service'=>'auto','apaczka_service_id'=>0,'pickup_type'=>'SELF','presets'=>['small'=>['name'=>'Mała','length'=>23,'width'=>16,'height'=>10,'weight'=>0.5],'medium'=>['name'=>'Średnia','length'=>30,'width'=>20,'height'=>15,'weight'=>1],'large'=>['name'=>'Duża','length'=>40,'width'=>30,'height'=>20,'weight'=>2]],'sender'=>['name'=>'','email'=>'','phone'=>'','street'=>'','building'=>'','postal_code'=>'','city'=>'']]}{/if}
{if !isset($shipmentSuggestion)}{assign var=shipmentSuggestion value=['carrier_account_id'=>0,'reason'=>'Wybierz aktywne konto nadawcze','preset'=>'','package'=>['length'=>30,'width'=>20,'height'=>15,'weight'=>1],'service'=>'inpost_locker_standard']}{/if}
{if !isset($shippingProviders)}{assign var=shippingProviders value=[]}{/if}
{if !isset($deliveryOverview)}{assign var=deliveryOverview value=[]}{/if}
{if !isset($documentDefaults)}{assign var=documentDefaults value=['vat'=>'23']}{/if}
{if !isset($ksefAccounts)}{assign var=ksefAccounts value=[]}{/if}
{if !isset($ksefTargets)}{assign var=ksefTargets value=[]}{/if}
{if !isset($ksefSubmissions)}{assign var=ksefSubmissions value=[]}{/if}

<div class="om-shell">
  <header class="om-hero">
    <div><div class="om-eyebrow">SPRZEDAŻ · REALIZACJA</div><h1>Centrum zamówień</h1><p>Jedna kolejka dla wszystkich kanałów sprzedaży.</p></div>
    <div class="om-hero-actions">{if $canWrite && $tab eq 'list'}<a class="om-btn om-primary" href="?controller=orders&tab=new"><i class="bi bi-plus-lg"></i> Nowe zamówienie</a>{/if}</div>
  </header>
  {if $flashSuccess}<div class="om-alert success">{$flashSuccess|escape}</div>{/if}
  {if $flashError}<div class="om-alert error">{$flashError|escape}</div>{/if}
  {if $tab eq 'new'}
    <section class="om-panel om-new-order">
      <div class="om-panel-heading"><div><h2>Nowe zamówienie własne</h2><p>Wprowadź klienta, produkty, walutę i sposób płatności.</p></div><a class="om-btn" href="?controller=orders"><i class="bi bi-x-lg"></i> Anuluj</a></div>
      <form method="post" action="?controller=orders&action=save" data-new-order-form>
        <input type="hidden" name="csrf" value="{$csrf|escape}"><input type="hidden" name="operation" value="create_order"><input type="hidden" name="tab" value="new">
        <div class="om-new-grid">
          <fieldset><legend>Klient i status</legend><label>Nazwa klienta<input name="buyer_name" required maxlength="255" autofocus></label><label>E-mail<input type="email" name="email"></label><label>Telefon<input name="phone"></label><label>Data zamówienia<input type="datetime-local" name="ordered_at" value="{$smarty.now|date_format:'%Y-%m-%dT%H:%M'}" required></label><label>Status<select name="status_id" required>{foreach $statuses as $s}<option value="{$s.id}">{$s.name|escape}</option>{/foreach}</select></label></fieldset>
          <fieldset><legend>Dostawa</legend><label>Metoda dostawy<input name="delivery" placeholder="Np. kurier, odbiór osobisty"></label><label>Koszt dostawy<input inputmode="decimal" name="shipping_price" value="0.00" data-new-shipping></label><label>Ulica<input name="shipping_street"></label><label>Nr budynku / lokalu<input name="shipping_building"></label><label>Kod pocztowy<input name="shipping_postal_code"></label><label>Miasto<input name="shipping_city"></label><label>Kraj<select name="shipping_country"><option value="PL">Polska (PL)</option><option value="CZ">Czechy (CZ)</option><option value="HU">Węgry (HU)</option><option value="DE">Niemcy (DE)</option><option value="SK">Słowacja (SK)</option><option value="AT">Austria (AT)</option><option value="RO">Rumunia (RO)</option><option value="GB">Wielka Brytania (GB)</option><option value="US">USA (US)</option></select></label></fieldset>
          <fieldset><legend>Płatność</legend><label>Metoda płatności<select name="payment_method" data-new-payment>{foreach $paymentMethods as $method}{if $method.enabled}<option value="{$method.name|escape}" data-cod="{$method.is_cod}">{$method.name|escape}</option>{/if}{/foreach}</select></label><label>Waluta<select name="currency" data-new-currency required>{foreach ['PLN'=>'PLN — złoty','EUR'=>'EUR — euro','USD'=>'USD — dolar amerykański','GBP'=>'GBP — funt','CZK'=>'CZK — korona czeska','HUF'=>'HUF — forint','CHF'=>'CHF — frank','SEK'=>'SEK — korona szwedzka','NOK'=>'NOK — korona norweska','DKK'=>'DKK — korona duńska','RON'=>'RON — lej','BGN'=>'BGN — lew','UAH'=>'UAH — hrywna'] as $code=>$label}<option value="{$code}" {if $code eq 'PLN'}selected{/if}>{$label}</option>{/foreach}</select></label><label>Zapłacono<input inputmode="decimal" name="amount_paid" value="0.00"></label><label class="om-check"><input type="checkbox" name="paid" value="1" data-new-paid> Płatność potwierdzona</label><label class="om-check"><input type="checkbox" name="cash_on_delivery" value="1" data-new-cod> Płatność przy odbiorze</label><label>Dokument<select name="document_preference"><option value="receipt">Paragon</option><option value="invoice">Faktura</option></select></label></fieldset>
        </div>
        <fieldset class="om-new-items"><legend>Produkty</legend><div class="om-new-items-head"><span>Dodaj wszystkie pozycje zamówienia. Suma wyliczy się automatycznie.</span><button class="om-btn" type="button" data-add-new-item><i class="bi bi-plus-lg"></i> Dodaj produkt</button></div><div data-new-items><div class="om-new-item"><label>Nazwa produktu<input name="items[0][name]" required></label><label>SKU<input name="items[0][sku]"></label><label>Ilość<input type="number" min="1" max="100000" name="items[0][quantity]" value="1" required data-new-qty></label><label>Cena brutto<input inputmode="decimal" name="items[0][price]" value="0.00" required data-new-price></label><label>VAT<select name="items[0][vat]">{foreach ['23','8','5','0','zw','np'] as $v}<option value="{$v}">{$v}{if $v ne 'zw' and $v ne 'np'}%{/if}</option>{/foreach}</select></label><strong data-new-line-total>0,00 PLN</strong><button class="om-icon-btn" type="button" data-remove-new-item aria-label="Usuń pozycję"><i class="bi bi-trash"></i></button></div></div></fieldset>
        <div class="om-new-footer"><label>Uwagi do zamówienia<textarea name="buyer_note" rows="2"></textarea></label><div><span>Razem</span><strong data-new-total>0,00 PLN</strong><input type="hidden" name="total" value="0.00" data-new-total-input><button class="om-btn om-primary"><i class="bi bi-check2"></i> Utwórz zamówienie</button></div></div>
      </form>
    </section>
  {elseif $tab eq 'list'}
    <div class="om-workspace {if $detail}has-detail{/if}">
      <aside class="om-status-list" aria-label="Grupy i statusy zamówień">
        <div class="om-label">KOLEJKI ZAMÓWIEŃ</div>
        <a href="?controller=orders" class="om-status-all {if $filters.status_id eq '' and $filters.group eq ''}active{/if}"><span><i class="om-all-dot"></i>Wszystkie</span><b>{$dashboard.total}</b></a>
        {foreach $statusGroups as $group}
          <div class="om-status-group">
            <a class="om-group-heading {if $filters.group eq $group.name and $filters.status_id eq ''}active{/if}" href="?controller=orders&group={$group.name|escape:'url'}"><span>{$group.name|escape}</span><b>{$group.total}</b></a>
            {foreach $group.statuses as $s}<a class="om-status-link {if $filters.status_id eq $s.id}active{/if}" href="?controller=orders&status_id={$s.id}"><span><i style="background:{$s.color|escape}"></i>{$s.name|escape}</span><b>{$s.total}</b></a>{/foreach}
          </div>
        {/foreach}
        <div class="om-queue-summary"><span><b>{$dashboard.today}</b> dzisiaj</span><span><b>{$dashboard.unpaid}</b> do weryfikacji</span></div>
      </aside>
      {if !$detail}<section class="om-panel om-order-list">
        <div class="om-list-heading"><div><h2>{if $filters.status_id neq ''}{foreach $dashboard.statuses as $s}{if $filters.status_id eq $s.id}{$s.name|escape}{/if}{/foreach}{elseif $filters.group neq ''}{$filters.group|escape}{else}Wszystkie zamówienia{/if}</h2>{if $filters.payment_source neq ''}<p><span class="om-chip">{$filters.platform|escape} · płatność: {if $filters.payment_source eq '__empty__'}(brak informacji z API){else}{$filters.payment_source|escape}{/if}</span> <a href="?controller=orders">Wyczyść</a></p>{/if}<p><strong>{$listing.total}</strong> wyników <span>·</span> aktualizowane z połączonych kont</p></div><div class="om-list-heading-actions"><span class="om-result-range">Strona {$listing.page} z {$listing.pages}</span><button class="om-icon-btn" type="button" data-density-toggle title="Zmień gęstość wierszy" aria-label="Zmień gęstość wierszy"><i class="bi bi-text-paragraph"></i></button><button class="om-btn" type="button" data-columns-open><i class="bi bi-layout-three-columns"></i> Kolumny</button></div></div>
        <form class="om-filter-form" method="get"><input type="hidden" name="controller" value="orders"><input type="hidden" name="status_id" value="{$filters.status_id|escape}"><input type="hidden" name="group" value="{$filters.group|escape}">
          <div class="om-listbar"><div class="om-search"><i class="bi bi-search"></i><input name="q" value="{$filters.q|escape}" placeholder="Szukaj po numerze, kliencie, e-mailu, telefonie, tagu…" aria-label="Szukaj zamówień"></div><select name="account_id" aria-label="Konto"><option value="">Wszystkie konta</option>{foreach $accounts as $a}<option value="{$a.id}" {if $filters.account_id eq $a.id}selected{/if}>{$a.platform|escape} · {$a.name|escape}</option>{/foreach}</select><button class="om-btn {if $activeFilterCount}is-filtered{/if}" type="button" data-filters-toggle aria-expanded="{if $activeFilterCount}true{else}false{/if}"><i class="bi bi-funnel"></i> Filtry{if $activeFilterCount}<b>{$activeFilterCount}</b>{/if}</button><button class="om-btn om-primary" type="submit"><i class="bi bi-search"></i> Pokaż</button></div>
          {if $filters.payment_source neq ''}<input type="hidden" name="payment_source" value="{$filters.payment_source|escape}">{/if}<div class="om-filter-drawer {if $activeFilterCount}is-open{/if}" data-filter-drawer>
            <label>Platforma<select name="platform"><option value="">Wszystkie</option>{foreach ['manual'=>'Własne','api'=>'Własny sklep (API)','allegro'=>'Allegro','erli'=>'ERLI','empik'=>'Empik','mediamarkt'=>'MediaMarkt','morele'=>'Morele','temu'=>'Temu','prestashop'=>'PrestaShop','woocommerce'=>'WooCommerce','altreo'=>'Altreo.pl'] as $value=>$label}<option value="{$value}" {if $filters.platform eq $value}selected{/if}>{$label}</option>{/foreach}</select></label>
            <label>Płatność<select name="paid"><option value="">Dowolna</option><option value="1" {if $filters.paid eq '1'}selected{/if}>Potwierdzona</option><option value="0" {if $filters.paid eq '0'}selected{/if}>Niepotwierdzona</option></select></label>
            <label>Data od<input type="date" name="date_from" value="{$filters.date_from|escape}"></label><label>Data do<input type="date" name="date_to" value="{$filters.date_to|escape}"></label>
            <label>Kwota od<input inputmode="decimal" name="amount_from" value="{$filters.amount_from|escape}" placeholder="0,00"></label><label>Kwota do<input inputmode="decimal" name="amount_to" value="{$filters.amount_to|escape}" placeholder="9999,00"></label>
            <label>Sortowanie<select name="sort"><option value="newest" {if $filters.sort eq 'newest'}selected{/if}>Najnowsze najpierw</option><option value="oldest" {if $filters.sort eq 'oldest'}selected{/if}>Najstarsze najpierw</option><option value="amount_desc" {if $filters.sort eq 'amount_desc'}selected{/if}>Kwota: malejąco</option><option value="amount_asc" {if $filters.sort eq 'amount_asc'}selected{/if}>Kwota: rosnąco</option><option value="buyer" {if $filters.sort eq 'buyer'}selected{/if}>Klient A–Z</option></select></label>
            <div class="om-filter-actions"><a href="?controller=orders{if $filters.status_id ne ''}&status_id={$filters.status_id|escape:'url'}{/if}">Wyczyść filtry</a><button class="om-btn om-primary" type="submit">Zastosuj filtry</button></div>
          </div>
        </form>
        <form method="post" action="?controller=orders&action=save"><input type="hidden" name="csrf" value="{$csrf|escape}">
          {if $canWrite}<div class="om-bulk"><label class="om-select-page"><input type="checkbox" id="om-select-all"> Zaznacz stronę</label><span data-selected-count>0 zaznaczonych</span><span class="om-bulk-separator"></span><select name="status_id" aria-label="Status zaznaczonych">{foreach $statuses as $s}<option value="{$s.id}">{$s.name|escape}</option>{/foreach}</select><button class="om-btn om-small" type="submit" name="operation" value="bulk"><i class="bi bi-arrow-left-right"></i> Zmień status</button>{if $manualRules.list|default:[]}<span class="om-bulk-separator"></span><span class="oa-bulk"><select name="rule_group" aria-label="Automatyzacja dla zaznaczonych" data-oa-bulk-rule><option value="">Automatyzacja dla zaznaczonych…</option>{foreach $manualRules.list as $mr}<option value="{$mr.id}" data-confirm="{if $mr.confirm}1{/if}">{$mr.name|escape}</option>{/foreach}</select><button class="om-btn om-small oa-bulk-run" type="submit" name="operation" value="run_rule" data-oa-bulk-run><i class="bi bi-lightning-charge-fill"></i> Uruchom</button></span>{else}<a class="oa-bulk-link" href="?controller=orders&tab=rules" title="Oznacz regułę jako akcję na liście, aby uruchamiać ją dla zaznaczonych zamówień"><i class="bi bi-lightning-charge"></i> Automatyzacje</a>{/if}<button class="om-btn om-small om-danger-outline" type="submit" name="operation" value="bulk_delete" data-confirm-click="Usunąć zaznaczone zamówienia? Tej operacji nie można cofnąć. Zamówienia z marketplace mogą pojawić się ponownie przy kolejnej synchronizacji, chyba że wcześniej wstrzymasz import konta w zakładce Konta."><i class="bi bi-trash"></i> Usuń zaznaczone</button></div>{/if}
          <div class="om-table-wrap"><table class="om-table om-orders-table" data-configurable-table><thead><tr>{if $canWrite}<th class="om-select-cell"></th>{/if}<th data-col="order">Numer zamówienia</th><th data-col="buyer">Klient</th><th data-col="products">Przedmioty</th><th data-col="amount" class="om-right">Kwota</th><th data-col="status">Status</th><th data-col="payment">Płatność</th><th data-col="delivery">Dostawa</th><th data-col="fulfillment">Dostawa i płatność</th><th data-col="source">Źródło</th><th data-col="tags">Tagi / notatka</th><th data-col="date">Data złożenia</th></tr></thead><tbody>
          {foreach $listing.rows as $o}<tr class="om-order-row{if $o.starred|default:0} is-starred{/if}" data-order-url="?controller=orders&id={$o.id}" data-preview-order="#{$o.id} · {$o.external_id|escape}" data-preview-buyer="{$o.buyer_name|escape}" data-preview-note="{$o.note|default:''|truncate:220:'…'|escape}">{if $canWrite}<td class="om-select-cell"><input type="checkbox" name="ids[]" value="{$o.id}" aria-label="Zaznacz {$o.external_id|escape}"></td>{/if}
            <td data-col="order"><div class="om-order-cell"><button class="om-star{if $o.starred|default:0} is-active{/if}" type="button" data-star-order="{$o.id}" aria-pressed="{if $o.starred|default:0}true{else}false{/if}" aria-label="Oznacz gwiazdką" title="{if $o.starred|default:0}Usuń gwiazdkę{else}Oznacz gwiazdką{/if}"{if !$canWrite} disabled{/if}><i class="bi {if $o.starred|default:0}bi-star-fill{else}bi-star{/if}"></i></button><div><a class="om-order-number" href="?controller=orders&id={$o.id}">{$o.id}</a><button class="om-external-number" type="button" data-copy-order="{$o.external_id|escape}" title="Kliknij, aby skopiować pełny numer: {$o.external_id|escape}"><i class="bi bi-copy"></i><span>{$o.external_short|escape}</span></button><small class="om-order-source"><span class="om-market {$o.platform|escape}">{$o.platform|escape}</span><span class="om-order-account" title="{$o.account_name|escape}">{$o.account_name|escape}</span></small><span class="om-flow-icons"><span class="om-flow-icon {if $o.tracking_numbers}is-done{elseif $o.tracking_pending}is-pending{/if}" title="{if $o.tracking_numbers}Nadano: {$o.tracking_numbers|escape}{elseif $o.tracking_pending}Przesyłka utworzona — oczekuje na numer nadania{else}Brak numeru nadania{/if}"><i class="bi bi-truck"></i></span>{assign var=wantsInvoice value=($o.document_choice|default:'receipt' neq 'receipt')}{if !$wantsInvoice or $o.receipt_numbers}<span class="om-flow-icon {if $o.receipt_numbers}is-done{/if}" title="{if $o.receipt_numbers}Paragon: {$o.receipt_numbers|escape}{else}Brak paragonu{/if}"><i class="bi bi-receipt"></i></span>{/if}{if $wantsInvoice or $o.invoice_numbers}<span class="om-flow-icon om-flow-text {if $o.invoice_numbers}is-done{/if}" title="{if $o.invoice_numbers}Faktura: {$o.invoice_numbers|escape}{else}Brak faktury{/if}">FV</span>{/if}</span></div></div></td>
            <td data-col="buyer"><strong class="om-ellipsis">{$o.buyer_name|escape}</strong><a class="om-cell-link om-ellipsis" href="mailto:{$o.email|escape}">{$o.email|escape}</a>{if $o.phone}<small class="om-ellipsis">{$o.phone|escape}</small>{/if}</td>
            <td data-col="products"><div class="om-products">{foreach $o.items as $item}<div class="om-product-line"><span class="om-product-thumb">{if $item.image_url}<img src="{$item.image_url|escape}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-product-image>{else}<i class="bi bi-box"></i>{/if}</span><span><strong>{$item.quantity}× {$item.name|escape}</strong>{if $item.sku}<small>SKU: {$item.sku|escape}</small>{/if}</span></div>{/foreach}{if $o.item_lines gt 3}<button type="button" class="om-more-products">+ {$o.item_lines-3} więcej</button>{/if}{if $o.item_lines eq 0}<span class="om-muted">Brak pozycji</span>{/if}</div></td>
            <td data-col="amount" class="om-right"><strong class="om-amount">{($o.total_cents/100)|string_format:'%.2f'} {$o.currency|escape}</strong><small>dostawa {($o.shipping_cents/100)|string_format:'%.2f'}</small></td>
            <td data-col="status"><span class="om-status" style="--status:{$o.color|escape}">{$o.status_name|escape}</span><small class="om-ellipsis">{$o.remote_status|escape}</small>{if $o.status_changed_short}<small class="om-status-changed" title="Ostatnia zmiana statusu (UTC): {$o.status_changed_at|escape}"><i class="bi bi-arrow-repeat"></i> {$o.status_changed_short|escape}</small>{/if}</td>
            <td data-col="payment">{if $o.cash_on_delivery|default:0}<span class="om-payment is-cod"><i class="bi bi-cash-coin"></i> Pobranie</span>{else}<span class="om-payment {if $o.paid}is-paid{/if}"><i class="bi {if $o.paid}bi-check-circle-fill{else}bi-clock{/if}"></i>{if $o.paid} Opłacone{else} Do weryfikacji{/if}</span>{/if}{if $o.document_choice|default:'receipt' eq 'invoice_nip'}<span class="om-doc-pill is-invoice-nip" title="Klient chce fakturę na firmę{if $o.document_nip} — NIP {$o.document_nip|escape}{/if}"><i class="bi bi-file-earmark-text"></i> FV z NIP</span>{elseif $o.document_choice|default:'receipt' eq 'invoice'}<span class="om-doc-pill is-invoice" title="Klient chce fakturę bez NIP (osoba prywatna)"><i class="bi bi-file-earmark-text"></i> FV bez NIP</span>{else}<span class="om-doc-pill is-receipt" title="Klient nie prosił o fakturę"><i class="bi bi-receipt"></i> Paragon</span>{/if}</td>
            <td data-col="delivery" class="om-delivery-cell"><strong class="om-ellipsis">{$o.delivery|default:'Brak danych'|escape}</strong>{if $o.pickup}<small class="om-cell-link om-ellipsis">{$o.pickup|escape}</small>{/if}</td>
            <td data-col="fulfillment" class="om-fulfillment-cell"><span class="om-ellipsis om-fulfillment-delivery" title="{$o.delivery|default:'Brak danych'|escape}"><i class="bi bi-truck"></i> {$o.delivery|default:'Brak danych'|escape}</span>{if $o.pickup}<small class="om-ellipsis">{$o.pickup|escape}</small>{/if}{if $o.cash_on_delivery|default:0}<span class="om-payment is-cod"><i class="bi bi-cash-coin"></i> Pobranie</span>{else}<span class="om-payment {if $o.paid}is-paid{/if}"><i class="bi {if $o.paid}bi-check-circle-fill{else}bi-clock{/if}"></i>{if $o.paid} Opłacone{else} Do weryfikacji{/if}</span>{/if}{if $o.document_choice|default:'receipt' eq 'invoice_nip'}<span class="om-doc-pill is-invoice-nip" title="Klient chce fakturę na firmę{if $o.document_nip} — NIP {$o.document_nip|escape}{/if}"><i class="bi bi-file-earmark-text"></i> FV z NIP</span>{elseif $o.document_choice|default:'receipt' eq 'invoice'}<span class="om-doc-pill is-invoice" title="Klient chce fakturę bez NIP (osoba prywatna)"><i class="bi bi-file-earmark-text"></i> FV bez NIP</span>{else}<span class="om-doc-pill is-receipt" title="Klient nie prosił o fakturę"><i class="bi bi-receipt"></i> Paragon</span>{/if}</td>
            <td data-col="source"><span class="om-market {$o.platform|escape}">{$o.platform|escape}</span><small class="om-ellipsis">{$o.account_name|escape}</small></td>
            <td data-col="tags">{if $o.tags}<span class="om-tag">{$o.tags|escape}</span>{/if}{if $o.note}<small class="om-ellipsis">{$o.note|escape}</small>{/if}{if $o.buyer_note|default:''}<small class="om-buyer-note" title="Wiadomość od kupującego: {$o.buyer_note|escape}"><i class="bi bi-chat-left-text"></i> {$o.buyer_note|escape}</small>{/if}{if !$o.tags && !$o.note && !$o.buyer_note|default:''}<span class="om-muted">—</span>{/if}</td>
