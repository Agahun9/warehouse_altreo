    <div class="om-two-col"><section class="om-panel om-pad"><h3>Statusy wewnętrzne</h3><p class="om-status-help">Przypisz status do grupy. Grupy pojawią się w kolejce zamówień i można je filtrować.</p><datalist id="om-status-groups">{foreach $statusGroups as $group}<option value="{$group.name|escape}">{/foreach}</datalist>{foreach $statusGroups as $group}<div class="om-status-config-group"><h4>{$group.name|escape} <span>{$group.statuses|count} {if $group.statuses|count eq 1}status{elseif $group.statuses|count lt 5}statusy{else}statusów{/if}</span></h4>{foreach $group.statuses as $s}<form class="om-inline-form" method="post" action="?controller=orders&action=save"><input type="hidden" name="csrf" value="{$csrf|escape}"><input type="hidden" name="operation" value="status"><input type="hidden" name="tab" value="statuses"><input type="hidden" name="status_id" value="{$s.id}"><input type="color" name="color" value="{$s.color|escape}" aria-label="Kolor"><input name="name" value="{$s.name|escape}" required aria-label="Nazwa statusu"><input name="group_name" value="{$s.group_name|escape}" list="om-status-groups" required maxlength="100" aria-label="Grupa statusu"><input type="number" name="position" value="{$s.position}" class="om-position" aria-label="Kolejność">{if $canWrite}<button class="om-btn">Zapisz</button>{/if}</form>{/foreach}</div>{/foreach}{if $canWrite}<h4 class="om-top">Nowy status</h4><form class="om-inline-form" method="post" action="?controller=orders&action=save"><input type="hidden" name="csrf" value="{$csrf|escape}"><input type="hidden" name="operation" value="status"><input type="hidden" name="tab" value="statuses"><input type="color" name="color" value="#6366f1" aria-label="Kolor nowego statusu"><input name="name" placeholder="Np. Czeka na dostawę" required><input name="group_name" list="om-status-groups" placeholder="Grupa, np. Do realizacji" maxlength="100" required><input type="number" name="position" value="10" class="om-position" aria-label="Kolejność"><button class="om-btn om-primary">Dodaj</button></form>{/if}</section>
    <section class="om-panel om-pad"><h3>Platforma → status wewnętrzny</h3>{if $canWrite}<form class="om-form" method="post" action="?controller=orders&action=save"><input type="hidden" name="csrf" value="{$csrf|escape}"><input type="hidden" name="operation" value="mapping"><input type="hidden" name="tab" value="statuses"><label>Konto<select name="account_id" required>{foreach $accounts as $a}<option value="{$a.id}">{$a.platform|escape} · {$a.name|escape}</option>{/foreach}</select></label><label>Status źródłowy<input name="remote_status" required placeholder="Np. READY_FOR_PROCESSING lub purchased"></label><label>Status wewnętrzny<select name="status_id">{foreach $statuses as $s}<option value="{$s.id}">{$s.name|escape}</option>{/foreach}</select></label><button class="om-btn om-primary">Zapisz mapowanie</button></form>{/if}{foreach $mappings as $m}<div class="om-mapping"><div><small>{$m.platform|escape} · {$m.account_name|escape}</small><p><code>{$m.remote_status|escape}</code> → <strong>{$m.status_name|escape}</strong></p></div>{if $canWrite}<form method="post" action="?controller=orders&action=save"><input type="hidden" name="csrf" value="{$csrf|escape}"><input type="hidden" name="operation" value="unmap"><input type="hidden" name="tab" value="statuses"><input type="hidden" name="mapping_id" value="{$m.id}"><button class="om-btn om-small">Usuń</button></form>{/if}</div>{foreachelse}<p class="om-muted om-top">Bez mapowania zamówienia trafiają do statusu „Nowe”.</p>{/foreach}</section></div>
