          {if $canWrite}<td><form method="post" action="index.php?controller=orders&action=save" class="om-delivery-map-form" data-delivery-map data-order-id="{$m.order_id}"><input type="hidden" name="csrf" value="{$csrf|escape}"><input type="hidden" name="operation" value="delivery_mapping"><input type="hidden" name="tab" value="shipments"><input type="hidden" name="platform" value="{$m.platform|escape}"><input type="hidden" name="delivery" value="{$m.delivery|escape}">
